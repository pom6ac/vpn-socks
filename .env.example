# Copy to .env and adjust before `docker compose up -d`.

# Absolute path to this project directory on the host. Required: the admin
# panel mounts it read-only to run `docker compose` commands.
HOST_PROJECT_DIR=/absolute/path/to/this/project

# OpenVPN config file (contains private keys — never commit it).
OVPN_CONFIG=./client.ovpn

# SOCKS5 proxy authentication (false = open proxy, but it is only published on 127.0.0.1).
SOCKS_REQUIRE_AUTH=false
PROXY_USER=
PROXY_PASSWORD=

# Optional: VPN server host(s) or IP(s), comma- or space-separated, that the
# kill switch in the ovpn container uses instead of the hosts of the config's
# `remote` lines (ports and protocols still come from the config). Empty: the
# `remote` hosts are used.
VPN_ENDPOINT_HOST=

# Expected VPN exit IP(s), comma-separated (several if your provider uses more
# than one exit address). The admin panel's egress_ip probe reports a leak
# (overall status "down") when the observed exit IP is not in this list.
# Empty: the exit IP is only displayed. An invalid entry stops the panel.
EXPECTED_EXIT_IP=

# Optional: extra comma-separated Host names (no port) accepted by the admin
# panel in addition to localhost, 127.0.0.1 and ::1.
#ADMIN_ALLOWED_HOSTS=vpn-admin.local

# Admin panel access token: see docker-compose.override.yml.example
# (ADMIN_TOKEN_FILE is set there together with the secret file).
